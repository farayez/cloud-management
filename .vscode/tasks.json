{
  // See https://go.microsoft.com/fwlink/?LinkId=733558
  // for the documentation about the tasks.json format
  "version": "2.0.0",
  "tasks": [
    {
      "label": "Clear Resource History",
      "type": "shell",
      "command": "npm",
      "problemMatcher": [],
      "args": ["run", "resource:clear_history"],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": false,
        "echo": false,
        "group": "Resource"
      }
    },
    {
      "label": "Push Image",
      "type": "shell",
      "command": "npm",
      "problemMatcher": [],
      "args": [
        "run",
        "image:push",
        "config=${input:configurationFilePicker}",
        "resource=${input:imagePicker}"
      ],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": false,
        "echo": false,
        "group": "Image"
      }
    },
    {
      "label": "Start Service",
      "type": "shell",
      "command": "npm",
      "problemMatcher": [],
      "args": [
        "run",
        "ecs:start_service",
        "config=${input:configurationFilePicker}",
        "resource=${input:servicePicker}"
      ],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": false,
        "echo": false,
        "group": "Service"
      }
    },
    {
      "label": "Stop Service",
      "type": "shell",
      "command": "npm",
      "problemMatcher": [],
      "args": [
        "run",
        "ecs:stop_service",
        "config=${input:configurationFilePicker}",
        "resource=${input:servicePicker}"
      ],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": false,
        "echo": false,
        "group": "Service"
      }
    },
    {
      "label": "Redeploy Service",
      "type": "shell",
      "command": "npm",
      "problemMatcher": [],
      "args": [
        "run",
        "ecs:redeploy_service",
        "config=${input:configurationFilePicker}",
        "resource=${input:servicePicker}"
      ],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": false,
        "echo": false,
        "group": "Service"
      }
    },
    {
      "label": "Exec into Container",
      "type": "shell",
      "command": "npm",
      "problemMatcher": [],
      "args": [
        "run",
        "ecs:exec_container",
        "config=${input:configurationFilePicker}",
        "resource=${input:servicePicker}"
      ],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false,
        "echo": false,
        "group": "Task"
      }
    },
    {
      "label": "SSH into Server",
      "type": "shell",
      "command": "npm",
      "problemMatcher": [],
      "args": [
        "run",
        "server:ssh",
        "config=${input:configurationFilePicker}",
        "resource=${input:serverPicker}"
      ],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false,
        "echo": false,
        "group": "Task"
      }
    },
    {
      "label": "Copy to Server",
      "type": "shell",
      "command": "npm",
      "problemMatcher": [],
      "args": [
        "run",
        "server:copy",
        "config=${input:configurationFilePicker}",
        "resource=${input:serverPicker}",
        "item=${input:serverResourceItemPicker}"
      ],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false,
        "echo": false,
        "group": "Task"
      }
    },
    {
      "label": "Run Command in Server",
      "type": "shell",
      "command": "npm",
      "problemMatcher": [],
      "args": [
        "run",
        "server:run_command",
        "config=${input:configurationFilePicker}",
        "resource=${input:serverPicker}",
        "item=${input:serverCommandItemPicker}"
      ],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "dedicated",
        "showReuseMessage": false,
        "clear": false,
        "echo": false,
        "group": "Task"
      }
    },
    {
      "label": "Pull Parameter",
      "type": "shell",
      "command": "npm",
      "problemMatcher": [],
      "args": [
        "run",
        "ssm_parameter:pull",
        "config=${input:configurationFilePicker}",
        "resource=${input:parameterPicker}"
      ],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": false,
        "echo": false,
        "group": "SSM Parameter"
      }
    },
    {
      "label": "Push Parameter",
      "type": "shell",
      "command": "npm",
      "problemMatcher": [],
      "args": [
        "run",
        "ssm_parameter:push",
        "config=${input:configurationFilePicker}",
        "resource=${input:parameterPicker}"
      ],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": false,
        "echo": false,
        "group": "SSM Parameter"
      }
    },
    {
      "label": "Deploy To S3",
      "type": "shell",
      "command": "npm",
      "problemMatcher": [],
      "args": [
        "run",
        "s3:deploy",
        "config=${input:configurationFilePicker}",
        "resource=${input:s3-application-picker}"
      ],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": false,
        "echo": false,
        "group": "S3"
      }
    },
    {
      "label": "Invalidate CloudFront Distribution",
      "type": "shell",
      "command": "npm",
      "problemMatcher": [],
      "args": [
        "run",
        "cloudfront:invalidate",
        "config=${input:configurationFilePicker}",
        "resource=${input:cloudfront-picker}"
      ],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": false,
        "echo": false,
        "group": "Cloudfront"
      }
    },
    {
      "label": "Validate Task Definition",
      "type": "shell",
      "command": "npm",
      "problemMatcher": [],
      "args": [
        "run",
        "task_definition:validate",
        "config=${input:configurationFilePicker}",
        "resource=${input:taskDefinitionPicker}"
      ],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": false,
        "echo": false,
        "group": "Task Definition"
      }
    },
    {
      "label": "Register Task Definition",
      "type": "shell",
      "command": "npm",
      "problemMatcher": [],
      "args": [
        "run",
        "task_definition:register",
        "config=${input:configurationFilePicker}",
        "resource=${input:taskDefinitionPicker}"
      ],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": false,
        "echo": false,
        "group": "Task Definition"
      }
    },
    {
      "label": "Create CloudFormation Stack",
      "type": "shell",
      "command": "npm",
      "problemMatcher": [],
      "args": [
        "run",
        "cloudformation:create_stack",
        "config=${input:configurationFilePicker}",
        "resource=${input:cfStackPicker}"
      ],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": false,
        "echo": false,
        "group": "CloudFormation"
      }
    },
    {
      "label": "Update CloudFormation Stack",
      "type": "shell",
      "command": "npm",
      "problemMatcher": [],
      "args": [
        "run",
        "cloudformation:update_stack",
        "config=${input:configurationFilePicker}",
        "resource=${input:cfStackPicker}"
      ],
      "presentation": {
        "reveal": "always",
        "focus": true,
        "panel": "shared",
        "showReuseMessage": false,
        "clear": false,
        "echo": false,
        "group": "CloudFormation"
      }
    }
  ],
  "inputs": [
    {
      "id": "configurationFilePicker",
      "type": "command",
      "command": "extension.commandvariable.file.pickFile",
      "args": {
        "keyRemember": "selectedConfigFile",
        "include": "configurations/*.config.json",
        "display": "transform",
        "valueTransform": {
          "text": "${fileBasename}"
        },
        "labelTransform": {
          "text": "${fileBasename}"
        }
      }
    },
    {
      "id": "servicePicker",
      "type": "command",
      "command": "extension.commandvariable.pickStringRemember",
      "args": {
        "description": "Which Service?",
        "fileName": "${workspaceFolder}/configurations/${remember:selectedConfigFile}",
        "fileFormat": "json",
        "jsonOption": "content.service[__itemIdx__ ].name"
      }
    },
    {
      "id": "serverPicker",
      "type": "command",
      "command": "extension.commandvariable.pickStringRemember",
      "args": {
        "description": "Which Server?",
        "key": "selectedServer",
        "fileName": "${workspaceFolder}/configurations/${remember:selectedConfigFile}",
        "fileFormat": "json",
        "jsonOption": "content.server[__itemIdx__ ].name"
      }
    },
    {
      "id": "serverResourceItemPicker",
      "type": "command",
      "command": "extension.commandvariable.pickStringRemember",
      "args": {
        "description": "Which Resource?",
        "key": "selectedServerResourceItem",
        "fileName": "${workspaceFolder}/configurations/${remember:selectedConfigFile}",
        "fileFormat": "json",
        "jsonOption": "content.server.find(s => s.name === '${remember:selectedServer}').resources[__itemIdx__].name"
      }
    },
    {
      "id": "serverCommandItemPicker",
      "type": "command",
      "command": "extension.commandvariable.pickStringRemember",
      "args": {
        "description": "Which Command?",
        "key": "selectedServerCommandItem",
        "fileName": "${workspaceFolder}/configurations/${remember:selectedConfigFile}",
        "fileFormat": "json",
        "jsonOption": "content.server.find(s => s.name === '${remember:selectedServer}').commands[__itemIdx__].name"
      }
    },
    {
      "id": "parameterPicker",
      "type": "command",
      "command": "extension.commandvariable.pickStringRemember",
      "args": {
        "description": "Which Parameter?",
        "fileName": "${workspaceFolder}/configurations/${remember:selectedConfigFile}",
        "fileFormat": "json",
        "jsonOption": "content.ssm_parameter[__itemIdx__ ].name"
      }
    },
    {
      "id": "imagePicker",
      "type": "command",
      "command": "extension.commandvariable.pickStringRemember",
      "args": {
        "description": "Which Image?",
        "fileName": "${workspaceFolder}/configurations/${remember:selectedConfigFile}",
        "fileFormat": "json",
        "jsonOption": "content.image[__itemIdx__ ].name"
      }
    },
    {
      "id": "taskDefinitionPicker",
      "type": "command",
      "command": "extension.commandvariable.pickStringRemember",
      "args": {
        "description": "Which Task Definition?",
        "fileName": "${workspaceFolder}/configurations/${remember:selectedConfigFile}",
        "fileFormat": "json",
        "jsonOption": "content.task_definition[__itemIdx__ ].name"
      }
    },
    {
      "id": "cfStackPicker",
      "type": "command",
      "command": "extension.commandvariable.pickStringRemember",
      "args": {
        "description": "Which CloudFormation Stack?",
        "fileName": "${workspaceFolder}/configurations/${remember:selectedConfigFile}",
        "fileFormat": "json",
        "jsonOption": "content.cloudformation[__itemIdx__ ].name"
      }
    },
    {
      "id": "image",
      "type": "command",
      "command": "extension.commandvariable.file.pickFile",
      "args": {
        "description": "Which Image?",
        "include": "images/*.config.sh",
        "valueTransform": {
          "text": "${fileBasename}",
          "find": ".config.sh",
          "replace": ""
        },
        "labelTransform": {
          "text": "${fileBasename}",
          "find": ".config.sh",
          "replace": ""
        },
        "display": "transform",
        "showDirs": false,
        "keyRemember": "selectedImage"
      }
    },
    {
      "id": "ssm-parameter",
      "type": "command",
      "command": "extension.commandvariable.file.pickFile",
      "args": {
        "description": "Which Parametr?",
        "include": "ssm_parameters/*.config.sh",
        "valueTransform": {
          "text": "${fileBasename}",
          "find": ".config.sh",
          "replace": ""
        },
        "labelTransform": {
          "text": "${fileBasename}",
          "find": ".config.sh",
          "replace": ""
        },
        "display": "transform",
        "showDirs": false,
        "keyRemember": "selectedParameter"
      }
    },
    {
      "id": "s3-application-picker",
      "type": "command",
      "command": "extension.commandvariable.pickStringRemember",
      "args": {
        "description": "Which Service?",
        "fileName": "${workspaceFolder}/configurations/${remember:selectedConfigFile}",
        "fileFormat": "json",
        "jsonOption": "content.s3_application[__itemIdx__ ].name"
      }
    },
    {
      "id": "cloudfront-picker",
      "type": "command",
      "command": "extension.commandvariable.pickStringRemember",
      "args": {
        "description": "Which CloudFront Distribution?",
        "fileName": "${workspaceFolder}/configurations/${remember:selectedConfigFile}",
        "fileFormat": "json",
        "jsonOption": "content.cloudfront[__itemIdx__ ].name"
      }
    },
    {
      "id": "task-definition",
      "type": "command",
      "command": "extension.commandvariable.file.pickFile",
      "args": {
        "description": "Which Parametr?",
        "include": "task_definitions/*.config.sh",
        "valueTransform": {
          "text": "${fileBasename}",
          "find": ".config.sh",
          "replace": ""
        },
        "labelTransform": {
          "text": "${fileBasename}",
          "find": ".config.sh",
          "replace": ""
        },
        "display": "transform",
        "showDirs": false,
        "keyRemember": "selectedParameter"
      }
    },
    {
      "id": "desiredCount",
      "type": "promptString",
      "default": "1",
      "description": "Desired task count in service"
    },
    {
      "id": "taskDefinitionRevision",
      "type": "promptString",
      "default": "",
      "description": "Task definition revision"
    }
  ]
}
