  "inputs": [
    {
      // Picks a config (yaml preferred over json, like parse_config.sh) and caches it as JSON for the pickers below
      "id": "configurationFilePicker",
      "type": "command",
      "command": "extension.commandvariable.transform",
      "args": {
        "text": "${transform:selectedConfig}${transform:configCache}",
        "transform": {
          "selectedConfig": {
            "text": "${pickFile:configFile}",
            "pickFile": {
              "configFile": {
                "keyRemember": "selectedConfigFile",
                "include": "configurations/*.config.{yaml,yml,json}",
                "display": "transform",
                "valueTransform": {
                  "text": "${fileBasename}",
                  "find": "\\.(json|ya?ml)$",
                  "replace": ""
                },
                "labelTransform": {
                  "text": "${fileBasename}",
                  "find": "\\.(json|ya?ml)$",
                  "replace": ""
                }
              }
            }
          },
          "configCache": {
            "text": "${jsExpression:configJson}",
            "saveToFile": "${workspaceFolder}/.vscode/.selected-config.json",
            "empty": true,
            "jsExpression": {
              "configJson": {
                "expression": "JSON.stringify(${fileContent:yaml} ?? ${fileContent:yml} ?? ${fileContent:json})",
                // A missing file is read as the string "Unknown", which maps to null here
                "fileContent": {
                  "yaml": {
                    "fileName": "${workspaceFolder}/configurations/${remember:selectedConfigFile}.yaml",
                    "yaml": "content !== null && typeof content === 'object' ? JSON.stringify(content) : 'null'"
                  },
                  "yml": {
                    "fileName": "${workspaceFolder}/configurations/${remember:selectedConfigFile}.yml",
                    "yaml": "content !== null && typeof content === 'object' ? JSON.stringify(content) : 'null'"
                  },
                  "json": {
                    "fileName": "${workspaceFolder}/configurations/${remember:selectedConfigFile}.json",
                    "yaml": "content !== null && typeof content === 'object' ? JSON.stringify(content) : 'null'"
                  }
                }
              }
            }
          }
        }
      }
    },
    {
      "id": "servicePicker",
      "type": "command",
      "command": "extension.commandvariable.pickStringRemember",
      "args": {
        "description": "Which Service?",
        "fileName": "${workspaceFolder}/.vscode/.selected-config.json",
        "fileFormat": "json",
        "jsonOption": "content.service[__itemIdx__ ].name"
      }
    },
    {
      "id": "serverPicker",
      "type": "command",
      "command": "extension.commandvariable.pickStringRemember",
      "args": {
        "description": "Which Server?",
        "key": "selectedServer",
        "fileName": "${workspaceFolder}/.vscode/.selected-config.json",
        "fileFormat": "json",
        "jsonOption": "content.server[__itemIdx__ ].name"
      }
    },
    {
      "id": "serverResourceItemPicker",
      "type": "command",
      "command": "extension.commandvariable.pickStringRemember",
      "args": {
        "description": "Which Resource?",
        "key": "selectedServerResourceItem",
        "fileName": "${workspaceFolder}/.vscode/.selected-config.json",
        "fileFormat": "json",
        "jsonOption": "content.server.find(s => s.name === '${remember:selectedServer}').resources[__itemIdx__].name"
      }
    },
    {
      "id": "serverCommandItemPicker",
      "type": "command",
      "command": "extension.commandvariable.pickStringRemember",
      "args": {
        "description": "Which Command?",
        "key": "selectedServerCommandItem",
        "fileName": "${workspaceFolder}/.vscode/.selected-config.json",
        "fileFormat": "json",
        "jsonOption": "content.server.find(s => s.name === '${remember:selectedServer}').commands[__itemIdx__].name"
      }
    },
    {
      "id": "parameterPicker",
      "type": "command",
      "command": "extension.commandvariable.pickStringRemember",
      "args": {
        "description": "Which Parameter?",
        "fileName": "${workspaceFolder}/.vscode/.selected-config.json",
        "fileFormat": "json",
        "jsonOption": "content.ssm_parameter[__itemIdx__ ].name"
      }
    },
    {
      "id": "imagePicker",
      "type": "command",
      "command": "extension.commandvariable.pickStringRemember",
      "args": {
        "description": "Which Image?",
        "fileName": "${workspaceFolder}/.vscode/.selected-config.json",
        "fileFormat": "json",
        "jsonOption": "content.image[__itemIdx__ ].name"
      }
    },
    {
      "id": "taskDefinitionPicker",
      "type": "command",
      "command": "extension.commandvariable.pickStringRemember",
      "args": {
        "description": "Which Task Definition?",
        "fileName": "${workspaceFolder}/.vscode/.selected-config.json",
        "fileFormat": "json",
        "jsonOption": "content.task_definition[__itemIdx__ ].name"
      }
    },
    {
      "id": "cfStackPicker",
      "type": "command",
      "command": "extension.commandvariable.pickStringRemember",
      "args": {
        "description": "Which CloudFormation Stack?",
        "fileName": "${workspaceFolder}/.vscode/.selected-config.json",
        "fileFormat": "json",
        "jsonOption": "content.cloudformation[__itemIdx__ ].name"
      }
    },
    {
      "id": "s3-application-picker",
      "type": "command",
      "command": "extension.commandvariable.pickStringRemember",
      "args": {
        "description": "Which Service?",
        "fileName": "${workspaceFolder}/.vscode/.selected-config.json",
        "fileFormat": "json",
        "jsonOption": "content.s3_application[__itemIdx__ ].name"
      }
    },
    {
      "id": "cloudfront-picker",
      "type": "command",
      "command": "extension.commandvariable.pickStringRemember",
      "args": {
        "description": "Which CloudFront Distribution?",
        "fileName": "${workspaceFolder}/.vscode/.selected-config.json",
        "fileFormat": "json",
        "jsonOption": "content.cloudfront[__itemIdx__ ].name"
      }
    },
    {
      "id": "task-definition",
      "type": "command",
      "command": "extension.commandvariable.file.pickFile",
      "args": {
        "description": "Which Parametr?",
        "include": "task_definitions/*.config.sh",
        "valueTransform": {
          "text": "${fileBasename}",
          "find": ".config.sh",
          "replace": ""
        },
        "labelTransform": {
          "text": "${fileBasename}",
          "find": ".config.sh",
          "replace": ""
        },
        "display": "transform",
        "showDirs": false,
        "keyRemember": "selectedParameter"
      }
    },
    {
      "id": "desiredCount",
      "type": "promptString",
      "default": "1",
      "description": "Desired task count in service"
    },
    {
      "id": "taskDefinitionRevision",
      "type": "promptString",
      "default": "",
      "description": "Task definition revision"
    }
  ]
}
